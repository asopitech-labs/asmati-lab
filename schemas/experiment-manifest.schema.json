{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asopitech-labs/asmati-lab/schemas/experiment-manifest.schema.json",
  "title": "asmati-lab experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "issue", "artifacts", "ci"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[0-9]{3}-[a-z0-9][a-z0-9-]*$"},
    "issue": {"type": "integer", "minimum": 1},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {"enum": ["file", "directory"]}
        }
      }
    },
    "ci": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "reason"],
          "properties": {
            "mode": {"const": "manual"},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "os", "toolchain", "steps"],
          "properties": {
            "mode": {"const": "automated"},
            "os": {"enum": ["ubuntu-latest", "macos-latest", "windows-latest"]},
            "toolchain": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "version"],
              "properties": {
                "kind": {"enum": ["system", "python", "nim"]},
                "version": {"type": "string", "minLength": 1}
              }
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "argv"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "argv": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1800},
                  "stdout_contains": {
                    "type": "array",
                    "items": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
