{
  "$schema": "../../schemas/experiment-manifest.schema.json",
  "schema_version": 1,
  "id": "007-nim-proc-runtime-call",
  "issue": 64,
  "artifacts": [
    {"path": "README.md", "kind": "file"},
    {"path": "src/proc_runtime.nim", "kind": "file"},
    {"path": "tests/prepare_outputs.py", "kind": "file"},
    {"path": "tests/toolchain.py", "kind": "file"},
    {"path": "tests/verify_generated_c.py", "kind": "file"},
    {"path": "observed/environment.txt", "kind": "file"},
    {"path": "observed/compile-2026-08-28.txt", "kind": "file"},
    {"path": "observed/run-2026-08-28.txt", "kind": "file"},
    {"path": "observed/generated-c-excerpt.c", "kind": "file"},
    {"path": "observed/runtime-definition-excerpt.nim", "kind": "file"},
    {"path": "observed/observation-table.md", "kind": "file"},
    {"path": "observed/unmapped-lines.md", "kind": "file"}
  ],
  "ci": {
    "mode": "automated",
    "os": "macos-latest",
    "toolchain": {"kind": "nim", "version": "2.2.10"},
    "steps": [
      {
        "name": "生成先を準備",
        "argv": ["python3", "tests/prepare_outputs.py"],
        "timeout_seconds": 30
      },
      {
        "name": "procと文字列操作をCへcompile",
        "argv": ["nim", "c", "--nimcache:observed/nimcache", "--out:observed/bin/proc_runtime", "src/proc_runtime.nim"],
        "timeout_seconds": 120
      },
      {
        "name": "source・生成C・runtime定義を検証",
        "argv": ["python3", "tests/verify_generated_c.py"],
        "timeout_seconds": 30,
        "stdout_contains": ["source proc, generated C function, and string runtime calls verified"]
      },
      {
        "name": "生成programを実行",
        "argv": ["./observed/bin/proc_runtime"],
        "timeout_seconds": 30,
        "stdout_contains": ["nim!"]
      }
    ]
  }
}
